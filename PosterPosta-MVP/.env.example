# 本文件仅是模板；复制为 .env 后由 Node --env-file=.env 加载。
APP_ENV=development
PORT=4180
PUBLIC_ORIGIN=http://127.0.0.1:4180

# 监听地址：默认 127.0.0.1，只对本机可用。
# 只有部署在反向代理之后（例如云端沙箱）才设为 0.0.0.0，
# 此时必须同时用 ALLOWED_HOSTS 列出对外域名（支持 *.example.com 通配），
# 否则请求会以 HOST_FORBIDDEN 被拒绝。允许的域名会同时加入 CSRF 来源白名单。
HOST=127.0.0.1
ALLOWED_HOSTS=

# 生产必须设置 APP_ENV=production，并配置有效 HTTPS origin 和以下三项。
# 验证码与到期投递仅使用固定 Resend HTTPS API；开发模式永不发邮件。
RESEND_API_KEY=
MAIL_FROM=
# 请在腾讯位置服务开放平台申请自己的服务端 WebService key 后填写。
TENCENT_LOCATION_KEY=

# 默认不信任 X-Forwarded-For。仅本机单层反向代理且主动覆盖该头时设置 loopback。
# 多级/逗号分隔 XFF 不被接受；不识别的城市返回 null，禁止当地领取。
TRUST_PROXY=

# 支付尚未接入，无任何环境变量能开启生产付费发货。
# 开发付费需显式调用 sandboxPurchase；所有交易真实扣款/收入均为 0。
# 默认数据库按环境隔离为 data/development.sqlite 或 data/production.sqlite。
# 可选绝对路径，生产请使用持久化磁盘并设置备份策略：
DB_PATH=
# 账号/资产持久保存；生产也应使用独立部署目录，绝不拷贝开发数据。
# 生产收件状态为 accepted，须收件邮箱验证并 POST /api/claim 后成为 received。
# 不确定的邮件任务保留为 uncertain 待人工核对，不自动重发、不自动删除用户资产。
